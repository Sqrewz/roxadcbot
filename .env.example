# =========================================================
# DISCORD (required)
# =========================================================
# Bot token from https://discord.com/developers/applications
# Invite must include scopes: bot + applications.commands
# and the "Voice States" intent enabled on the Bot page.
DISCORD_TOKEN=

# =========================================================
# PRESENCE / STATUS (makes the bot visible, "Streaming RoxaTheChief")
# =========================================================
# Text shown under the bot's name.
ACTIVITY=RoxaTheChief
# Type: Watching | Playing | Listening | Streaming | Competing
ACTIVITY_TYPE=Streaming
# Required for the purple "Streaming/LIVE" badge: your stream URL.
ACTIVITY_URL=https://www.twitch.tv/mystream
# Status: online | idle | dnd | invisible
STATUS=dnd

# Prefix for text commands (default !). E.g. !play, !ping
PREFIX=!

# =========================================================
# TWITCH integration
# =========================================================
# Create an app at https://dev.twitch.tv/console/apps -> Manage
# -> Client ID (right side) and Client Secret (New Secret + show).
# Callback URL can be "http://localhost".
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Which Twitch channels (logins) to track for stream notifications.
# Comma-separated, lowercase: twitch, otherchannel
TWITCH_CHANNELS=mystream

# Your own Twitch login, used to connect to your chat (lowercase).
TWITCH_LOGIN=mystream

# Chat OAuth token (https://twitchapps.com/tmi -> connect -> get token).
# Format: oauth:abcdef1234...
TWITCH_CHAT_OAUTH=

# =========================================================
# MODERATION
# =========================================================
# Role ID allowed to use mod commands (empty = everyone can).
# Right-click role -> Copy Role ID.
MOD_ROLE_ID=
# Channel where /report and !report messages go. Right-click channel -> Copy Channel ID.
REPORT_CHANNEL_ID=

# Your Kick channel name (lowercase) whose chat to mirror.
# Reading Kick chat needs NO credentials. Leave empty to disable.
# NOTE: Kick's browser (puppeteer) may not work on all hosts.
KICK_CHANNEL=